# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# generated at install time by scripts/postinstall-chromium.mjs — see
# src/lib/pdf/render.ts for why this isn't committed (it's rebuilt fresh on
# every install so it always matches the pinned @sparticuz/chromium version)
/chromium-bin

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch scripts (not part of the app)
test-letterhead*.mjs

# source logo file dropped at repo root during asset handoff (2026-07-12) —
# the actual asset lives at public/logos/connex-logo.png, this is just the
# original upload and isn't meant to be committed
/CONNEX3_LogoAPP.PNG

# Sandbox-editor leftovers (2026-10-16): the dev sandbox's filesystem leaves
# behind ".fuse_hidden<inode>" temp files when a file open in another process
# gets in-place-edited, and undeletable "*.tsx.bak" files from the
# rename-instead-of-delete workaround used when a route file can't be
# removed (see git history around the CONNEX Access split for why — the
# sandbox blocks `rm`/`os.remove` on certain files). Neither is meant to be
# committed; this line exists because one slipped into a commit by accident
# once already (missing src/app/access/settings/page.tsx, 2026-10-16) when a
# .fuse_hidden file got checked instead of the real page during manual
# file selection in GitHub Desktop.
.fuse_hidden*
*.tsx.bak
*.ts.bak
